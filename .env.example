DEEPSEEK_API_KEY=your_api_key_here

# ===== 可选配置（不写则用默认值） =====
# PDF_FILE=劳动合同.pdf

# 检索模式：hybrid | dense | bm25 | tfidf
# RETRIEVER_MODE=hybrid

# 是否启用 BGE Reranker 精排
# USE_RERANKER=true

# 是否启用多轮 query 改写（多耗一次 LLM 调用）
# ENABLE_QUERY_REWRITE=true

# 替换 PDF 后置 true 跑一次以重建向量库，之后改回 false
# FORCE_REBUILD_INDEX=false

# 检索候选数 / 精排保留数
# TOP_K_RECALL=20
# TOP_K_RERANK=5
